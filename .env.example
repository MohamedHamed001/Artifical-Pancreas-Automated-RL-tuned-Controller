# Copy to .env (which is gitignored) and edit locally.
# These overrides are optional; defaults are baked into the package.

# Release URL for downloadable model checkpoints.
# Expected to host diabetes_actor_best.h5 and diabetes_critic_best.h5.
# Example: https://github.com/<org>/<repo>/releases/download/v0.1.0
AP_RL_CHECKPOINT_URL=

# Optional override for the test-scenario data root.
# Defaults to <repo_root>/data/test_scenarios/ (with fallback to legacy TestData/).
AP_RL_DATA_DIR=

# Optional global RNG seed for reproducible Streamlit / training runs.
AP_RL_SEED=
